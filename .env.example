# Copy to .env.local for development. Every variable is optional in development.

# Required in production: at least 32 random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# Public origin, used for absolute links (emails, sitemap, social previews).
# An https:// value also enables HSTS and upgrade-insecure-requests. Set it at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Creates the first reviewer account at startup when no account with this email exists.
# ADMIN_EMAIL=reviews@example.org
# ADMIN_PASSWORD=use-a-long-unique-password-123
# ADMIN_NAME=Review team

# Demo campaigns and demo accounts (password demo1234). Defaults to on outside production.
# SEED_DEMO_DATA=false

# Private evidence uploads. Must be outside public/ and on a persistent volume.
# EVIDENCE_DIR=.data/evidence
# MAX_UPLOAD_BYTES=5242880

# Password-reset email through Resend. Without these, development prints emails to the console.
# RESEND_API_KEY=
# EMAIL_FROM=Shohay <no-reply@example.org>
